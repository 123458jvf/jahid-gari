      </div>

      <div
        class="row"
        style="margin-top:10px">

        <button
          class="btn"
          onclick="resendVerification()">
          আবার Email পাঠান
        </button>

        <button
          class="green"
          onclick="checkVerified()">
          আমি Verify করেছি
        </button>

      </div>

    </div>


    <button
      class="gray"
      style="width:100%;margin-top:10px"
      onclick="closeLogin()">
      বন্ধ
    </button>

  </div>

</div>


