          onclick="login()">
          Login
        </button>

        <button
          class="green"
          onclick="register()">
          New Account
        </button>

      </div>

      <button
        class="gray"
        style="width:100%;margin-top:8px"
        onclick="googleLogin()">
        Continue with Google
      </button>

      <button
        class="gray"
        style="width:100%;margin-top:8px"
        onclick="resetPassword()">
        Forgot Password
      </button>

    </div>


    <div
      id="verifyBox"
      class="hidden">

      <div class="notice">

        ✉️ Gmail-এ verification link পাঠানো হয়েছে।

        <br><br>

