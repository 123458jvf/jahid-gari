    </div>

    <div class="stat">
      <span>আজকের খরচ</span>
      <b id="todayExpense">৳0</b>
    </div>

    <div class="stat">
      <span>আজকের লাভ</span>
      <b id="todayProfit">৳0</b>
    </div>

    <div class="stat">
      <span>অবস্থা</span>
      <b id="todayStatus">চালু</b>
    </div>

  </div>

</section>


<!-- INCOME -->

<section class="card no-print">

  <h2>
    ➕ দৈনিক আয়
  </h2>

  <div class="grid2">

    <div>

      <label>
        তারিখ
      </label>

      <input
        id="incomeDate"
        type="date">

    </div>

    <div>

      <label>
        আয়
      </label>

      <input
        id="incomeAmount"
