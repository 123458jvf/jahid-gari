        </tr>

      </thead>

      <tbody id="dailyTable">
      </tbody>

    </table>

  </div>

</section>


<!-- BACKUP -->

<section class="card no-print">

  <h2>
    💾 Backup
  </h2>

  <div class="row">

    <button
      class="btn"
      onclick="backup()">
      JSON Backup
    </button>

    <button
      class="gray"
      onclick="document.getElementById('restoreFile').click()">
      Restore
    </button>

    <button
      class="green"
      onclick="downloadPDF()">
      📄 PDF Save
    </button>

    <input
      id="restoreFile"
      type="file"
      accept=".json,application/json"
      class="hidden"
      onchange="restore(this.files[0])">

  </div>

  <p class="muted">
    Gmail Login করলে Cloud Sync হবে।
    একই Gmail দিয়ে অন্য ফোনে Login করলে আগের হিসাব পাওয়া যাবে।
  </p>

</section>


<!-- SETTINGS -->

<section
  id="settingsCard"
  class="card no-print hidden">

  <div class="between">

    <h2>
      ⚙️ Settings
    </h2>

    <button
      class="gray"
      onclick="hideSettings()">
      বন্ধ
    </button>

  </div>

  <div class="grid2">

    <div>

      <label>
        App Name
      </label>

      <input
        id="settingTitle"
        value="জাহিদ পরিবহন">

    </div>

    <div>

      <label>
        Custom Logo
      </label>

      <input
        id="logoFile"
        type="file"
        accept="image/*">

    </div>

  </div>

  <div
    class="row"
    style="margin-top:10px">

    <button
      class="btn"
      onclick="saveSettings()">
      Save
    </button>

    <button
      class="gray"
      onclick="resetLogo()">
      CNG Logo Reset
    </button>

  </div>

</section>


<!-- ADMIN -->

<section
  id="adminPanel"
  class="card no-print hidden">

  <div class="between">

    <h2>
      👑 Admin Panel
    </h2>

    <span class="badge">
      md0756404@gmail.com
    </span>

  </div>

  <p class="muted">
    Admin এখানে ব্যবহারকারীদের Cloud হিসাব দেখতে পারবে।
  </p>

  <div id="adminUsers">
  </div>

</section>

</div>


<!-- LOGIN -->

<div id="loginGate">

  <div class="login">

    <div
      class="logo"
      id="loginLogo">
    </div>

    <h2>
      Gmail Login
    </h2>

    <p class="muted">
      Cloud Backup ও অন্য ফোনে হিসাব পেতে Login করুন।
    </p>

    <div
      id="loginMsg"
