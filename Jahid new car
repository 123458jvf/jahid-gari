  document.getElementById(
    "appTitle"
  ).textContent =
    localStorage.getItem(
      "appTitle"
    ) ||
    "জাহিদ পরিবহন";


  const tabs =
    document.getElementById(
      "profileTabs"
    );

  tabs.innerHTML = "";


  Object.entries(
    DB.profiles
  ).forEach(
    ([id,p])=>{

      const button =
        document.createElement(
          "button"
        );


      button.className =
        id === DB.active
        ?
        "btn"
        :
        "gray";


      button.textContent =
        "🚕 " +
        (
          p.name ||
          id
        );


      button.onclick =
        ()=>{

          DB.active =
            id;

          saveLocal();

          render();

        };


      tabs.appendChild(
        button
      );

    }
  );


  const p =
    currentProfile();


  const m =
    currentMonth();


  const dates =
    Object.keys(
      p.day || {}
    )
    .filter(
      d=>d.startsWith(m)
    );


  let monthIncome = 0;
  let monthExpense = 0;
  let runningDays = 0;


  dates.forEach(
    date=>{

      monthIncome +=
        Number(
          p.day[date] || 0
        );


      monthExpense +=
        (p.exp || [])
        .filter(
          e=>e.date === date
        )
        .reduce(
          (sum,e)=>
            sum +
            Number(
              e.amount || 0
            ),
          0
        );


      if(
        !p.off?.[date]
      ){

        runningDays++;

      }

    }
  );


  const td =
    today();


  const todayIncome =
    Number(
      p.day?.[td] || 0
    );


  const todayExpense =
    (p.exp || [])
    .filter(
      e=>e.date === td
    )
    .reduce(
      (sum,e)=>
        sum +
        Number(
          e.amount || 0
        ),
      0
    );


  document.getElementById(
    "todayText"
  ).textContent =
    td;


  document.getElementById(
    "todayIncome"
  ).textContent =
    money(todayIncome);


  document.getElementById(
    "todayExpense"
  ).textContent =
    money(todayExpense);


  document.getElementById(
    "todayProfit"
  ).textContent =
    money(
      todayIncome -
      todayExpense
    );


  document.getElementById(
    "todayStatus"
  ).textContent =
    p.off?.[td]
    ?
    "অফ"
    :
    "চালু";


  document.getElementById(
    "monthIncome"
  ).textContent =
    money(monthIncome);


  document.getElementById(
    "monthExpense"
  ).textContent =
    money(monthExpense);


  document.getElementById(
    "monthProfit"
  ).textContent =
    money(
      monthIncome -
      monthExpense
    );


  document.getElementById(
    "runDays"
  ).textContent =
    bn(runningDays);


  /* Vehicle */

  document.getElementById(
    "carName"
  ).value =
    p.name || "";


  document.getElementById(
    "carDate"
  ).value =
    p.pdate || "";


  document.getElementById(
    "carPrice"
  ).value =
    p.price || 0;


  document.getElementById(
    "carRate"
  ).value =
    p.rate || 500;


  let recovered = 0;


  Object.entries(
    p.day || {}
  ).forEach(
    ([date,value])=>{

      if(
        date >=
        String(
          p.pdate || ""
        )
      ){

        recovered +=
          Number(
            value || 0
          );

      }

    }
  );


  const price =
    Number(
      p.price || 0
    );


  const percentage =
    price > 0
    ?
    Math.min(
      100,
      recovered / price * 100
    )
    :
    0;


  document.getElementById(
    "recoveryText"
  ).textContent =
    money(recovered) +
    " / " +
    money(price);


  document.getElementById(
    "recoveryBar"
  ).style.width =
    percentage + "%";


  /* Daily table */

  const table =
    document.getElementById(
      "dailyTable"
    );

  table.innerHTML = "";


  dates
  .sort()
  .reverse()
  .forEach(
    date=>{

      const inc =
        Number(
          p.day[date] || 0
        );


      const out =
        (p.exp || [])
        .filter(
          e=>e.date === date
        )
        .reduce(
          (sum,e)=>
            sum +
            Number(
              e.amount || 0
            ),
          0
        );


      const tr =
        document.createElement(
          "tr"
        );


      tr.innerHTML = `

        <td>${date}</td>

        <td>
          ${money(inc)}
        </td>

        <td>
          ${money(out)}
        </td>

        <td>
          ${money(inc-out)}
        </td>

        <td>
          ${
            p.off?.[date]
            ?
            "অফ"
            :
            "চালু"
          }
        </td>

        <td class="no-print">

          <button
            class="red small"
            onclick="deleteDay('${date}')">

            Delete

          </button>

        </td>

      `;


      table.appendChild(
        tr
      );

    }
  );


  /* Login status */

  document.getElementById(
    "userState"
  ).textContent =
    AUTH_USER
    ?
    "☁️ Cloud Connected"
    :
    "📱 Guest Mode";


  document.getElementById(
    "userEmail"
  ).textContent =
    AUTH_USER
    ?
    (
      AUTH_USER.email ||
      "Google Account"
    )
    :
    "Gmail Login করলে Cloud Backup চালু হবে";


  const admin =
    isAdmin();


  document.getElementById(
    "adminBadge"
  )
  .classList
  .toggle(
    "hidden",
    !admin
  );


  document.getElementById(
    "adminPanel"
  )
  .classList
  .toggle(
    "hidden",
    !admin
  );


  if(admin){

    loadAdminUsers();

  }

}


