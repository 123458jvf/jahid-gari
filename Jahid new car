/* =========================
   CLOUD SAVE
========================= */

async function cloudPush(){

  if(!AUTH_USER)
    return;

  try{

    await setDoc(
      userRef(AUTH_USER.uid),
      {

        json:
          JSON.stringify(DB),

        ts:
          DB.ts,

        email:
          AUTH_USER.email || "",

        updatedAt:
          serverTimestamp()

      },
      {
        merge:true
      }
    );


    /* User index for Admin */

    await setDoc(

      doc(
        db,
        "users",
        AUTH_USER.uid
      ),

      {

        email:
          AUTH_USER.email || "",

        updatedAt:
          serverTimestamp()

      },

      {
        merge:true
      }

    );

  }catch(error){

    console.error(
      "Cloud save error:",
      error
    );

  }

}


/* =========================
   CLOUD LOAD
========================= */

async function cloudPull(){

  if(!AUTH_USER)
    return;

  try{

    const snap =
      await getDoc(
        userRef(
          AUTH_USER.uid
        )
      );


    if(
      snap.exists() &&
      snap.data().json
    ){

      const cloudData =
        JSON.parse(
          snap.data().json
        );


      const cloudTime =
        Number(
          snap.data().ts || 0
        );

      const localTime =
        Number(
          DB.ts || 0
        );


      /*
       Same Firebase path:
       users/{uid}/data/hisab
      */

      if(
        cloudTime >= localTime
      ){

        DB =
          cloudData;

        localStorage.setItem(
          LOCAL_KEY,
          JSON.stringify(DB)
        );

      }else{

        await cloudPush();

      }

    }else{

      /*
       First login:
       upload current local data
      */

      await cloudPush();

    }


    render();

  }catch(error){

    console.error(
      "Cloud load error:",
      error
    );

  }

}


