        div.querySelector(
          "button"
        ).onclick =
          ()=>adminView(
            document.id,
            data.email ||
            document.id
          );


        box.appendChild(
          div
        );

      }
    );


    if(
      !snapshot.size
    ){

      box.innerHTML =
        "<p class='muted'>কোনো User পাওয়া যায়নি।</p>";

    }


  }catch(error){

    box.innerHTML =
      "Admin data load error: " +
      error.message;

  }

}


/* =========================
   ADMIN VIEW
========================= */

async function adminView(
  uid,
  email
){

  try{

    const snapshot =
      await getDoc(
        userRef(uid)
      );


    if(
      !snapshot.exists()
    ){

      alert(
        "এই User-এর হিসাব নেই"
      );

      return;

    }


    const data =
      JSON.parse(
        snapshot.data().json
      );


    let income = 0;
    let expense = 0;


    Object.values(
      data.profiles || {}
    )
    .forEach(
      p=>{

        Object.values(
          p.day || {}
        )
        .forEach(
          value=>{

            income +=
              Number(
                value || 0
              );

          }
        );


        (p.exp || [])
        .forEach(
          e=>{

            expense +=
              Number(
                e.amount || 0
              );

          }
        );

      }
    );


    alert(

      "User: " +
      email +

      "\n\nমোট আয়: " +
      money(income) +

      "\nমোট খরচ: " +
      money(expense) +

      "\nমোট লাভ: " +
      money(
        income -
        expense
      )

    );


  }catch(error){

    alert(
      error.message
    );

  }

}


