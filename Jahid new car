        type="email"
        placeholder="your@gmail.com">

      <label style="margin-top:9px">
        Password
      </label>

      <input
        id="password"
        type="password"
        placeholder="কমপক্ষে 6 অক্ষর">

      <div
        class="row"
        style="margin-top:10px">

