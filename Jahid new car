/* =========================
   AUTH STATE
========================= */

onAuthStateChanged(
  auth,
  async user=>{

    if(!user){

      AUTH_USER =
        null;

      render();

      return;

    }


    /*
     Google login is verified.
     Email login must be verified.
    */

    const google =
      (user.providerData || [])
      .some(
        provider=>
          provider.providerId ===
          "google.com"
      );


    if(
      google ||
      user.emailVerified
    ){

      AUTH_USER =
        user;


      await cloudPull();

    }else{

      PENDING_USER =
        user;

    }


    render();

  }
);


