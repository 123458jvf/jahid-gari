<!DOCTYPE html>
<html lang="bn" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#087f8c">
<title>জাহিদ পরিবহন</title>

<style>
:root{
  --bg:#eef3f7;
  --card:#ffffff;
  --text:#10202b;
  --muted:#667784;
  --primary:#087f8c;
  --primary2:#073b4c;
  --line:#dce5ea;
  --danger:#c92a2a;
  --success:#2b8a3e;
  --shadow:0 8px 24px rgba(16,32,43,.08);
}

*{box-sizing:border-box}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:Arial,"Noto Sans Bengali",sans-serif;
}

button,input,select,textarea{
  font:inherit;
}

button{
  border:0;
  border-radius:11px;
  padding:10px 13px;
  cursor:pointer;
  font-weight:700;
}

.btn{
  background:var(--primary);
  color:white;
}

.gray{
  background:#e9eef2;
  color:#24333d;
}

.red{
  background:#ffe3e3;
  color:#a61e1e;
}

.green{
  background:#d3f9d8;
  color:#176b2b;
}

.wrap{
  max-width:1150px;
  margin:auto;
  padding:14px;
}

/* HEADER */

.top{
  background:linear-gradient(135deg,#073b4c,#087f8c);
  color:white;
  border-radius:20px;
  padding:16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  box-shadow:var(--shadow);
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  min-width:0;
}

.brand h1{
  font-size:30px;
  margin:0;
  font-weight:900;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.logo{
  width:78px;
  height:78px;
  flex:none;
  border-radius:18px;
  background:white;
  padding:5px;
  display:grid;
  place-items:center;
  box-shadow:0 4px 12px rgba(0,0,0,.18);
}

.logo svg{
  width:100%;
  height:100%;
}

.logo img{
  width:100%;
  height:100%;
  object-fit:contain;
  border-radius:12px;
}

.actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  justify-content:flex-end;
}

.actions button{
  background:#ffffff20;
  color:white;
  border:1px solid #ffffff35;
}

/* CARD */

.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  padding:15px;
  margin-top:14px;
  box-shadow:var(--shadow);
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}

.grid2{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}

label{
  font-size:13px;
  color:var(--muted);
  font-weight:700;
  display:block;
  margin-bottom:5px;
}

input,
select,
textarea{
  width:100%;
  border:1px solid var(--line);
  border-radius:10px;
  padding:10px;
  background:var(--card);
  color:var(--text);
}

textarea{
  min-height:70px;
}

h2,h3{
  margin:5px 0 12px;
}

.row{
  display:flex;
  gap:8px;
  align-items:center;
  flex-wrap:wrap;
}

.between{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.stat{
  background:#f7fafb;
  border:1px solid var(--line);
  border-radius:14px;
  padding:13px;
}

.stat b{
  display:block;
  font-size:21px;
  margin-top:5px;
}

.badge{
  display:inline-block;
  padding:5px 9px;
  border-radius:99px;
  background:#e7f5ff;
  color:#1864ab;
  font-size:12px;
  font-weight:700;
}

.muted{
  color:var(--muted);
  font-size:13px;
}

.hidden{
  display:none!important;
}

.scroll{
  overflow:auto;
}

table{
  width:100%;
  border-collapse:collapse;
}

th,td{
  padding:9px 6px;
  border-bottom:1px solid var(--line);
  text-align:left;
  font-size:13px;
}

th{
  background:#f4f7f8;
}

.progress{
  height:13px;
  background:#e9ecef;
  border-radius:99px;
  overflow:hidden;
}

.progress i{
  display:block;
  height:100%;
  width:0;
  background:var(--primary);
}

.notice{
  padding:10px;
  border-radius:10px;
  background:#fff4cc;
  color:#795500;
  font-size:13px;
}

.oknotice{
  background:#d3f9d8;
  color:#176b2b;
}

.small{
  font-size:12px;
}

/* LOGIN */

#loginGate{
  position:fixed;
  inset:0;
  background:rgba(7,30,41,.93);
  display:none;
  align-items:center;
  justify-content:center;
  padding:18px;
  z-index:50;
}

.login{
  background:white;
  color:#10202b;
  border-radius:20px;
  max-width:430px;
  width:100%;
  padding:20px;
}

.login h2{
  text-align:center;
}

.login .logo{
  margin:auto;
  width:88px;
  height:88px;
}

/* ADMIN */

.admin-user{
  background:#f7fafb;
  border:1px solid var(--line);
  border-radius:14px;
  padding:12px;
  margin-top:8px;
}

/* DARK */

html[data-theme="dark"]{
  --bg:#101820;
  --card:#17232d;
  --text:#edf2f4;
  --muted:#aab8c0;
  --line:#30404b;
}

html[data-theme="dark"] .stat,
html[data-theme="dark"] th,
html[data-theme="dark"] .admin-user{
  background:#1d2b35;
}

html[data-theme="dark"] input,
html[data-theme="dark"] select,
html[data-theme="dark"] textarea{
  background:#142029;
  color:#fff;
}

/* MOBILE */

@media(max-width:760px){

  .top{
    align-items:flex-start;
  }

  .brand h1{
    font-size:23px;
  }

  .logo{
    width:65px;
    height:65px;
  }

  .grid{
    grid-template-columns:repeat(2,1fr);
  }

  .grid2{
    grid-template-columns:1fr;
  }

  .actions{
    max-width:150px;
  }

  .actions button{
    font-size:12px;
    padding:8px;
  }
}

@media(max-width:430px){

  .wrap{
    padding:9px;
  }

  .top{
    padding:12px;
  }

  .brand{
    gap:8px;
  }

  .brand h1{
    font-size:20px;
  }

  .logo{
    width:58px;
    height:58px;
  }

  .card{
    padding:12px;
  }
}

/* PRINT */

@media print{

  body{
    background:white;
  }

  .no-print,
  #loginGate,
  .actions,
  .tabs{
    display:none!important;
  }

  .card{
    box-shadow:none;
    border:0;
  }
}
</style>
</head>

<body>

<div class="wrap">

<!-- HEADER -->

<header class="top">

  <div class="brand">

    <div class="logo" id="logoBox"></div>

    <h1 id="appTitle">
      জাহিদ পরিবহন
    </h1>

  </div>

  <div class="actions no-print">

    <button onclick="openLogin()">
      🔐 Gmail
    </button>

    <button onclick="toggleTheme()">
      🌙
    </button>

    <button onclick="showSettings()">
      ⚙️
    </button>

  </div>

</header>


<!-- USER STATUS -->

<section class="card no-print">

  <div class="between">

    <div>

      <b id="userState">
