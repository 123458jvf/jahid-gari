    </div>

  </div>

  <div
    class="row"
    style="margin-top:10px">

    <button
      class="btn"
      onclick="addIncome()">
      আয় Save
    </button>

    <button
      class="gray"
      onclick="setTodayIncome()">
      আজকের তারিখ
    </button>

  </div>

</section>


<!-- EXPENSE -->

<section class="card no-print">

  <h2>
    ➖ খরচ / মালামাল
  </h2>

  <div class="grid">

    <div>

      <label>
        তারিখ
      </label>

      <input
        id="expenseDate"
        type="date">

    </div>

    <div>

      <label>
        ক্যাটাগরি
      </label>

      <select id="expenseCat">

        <option>গ্যাস</option>
        <option>তেল</option>
        <option>মালামাল</option>
        <option>মেরামত</option>
        <option>ড্রাইভার</option>
        <option>চা-নাস্তা</option>
        <option>অন্যান্য</option>

      </select>

    </div>

    <div>

      <label>
        টাকা
      </label>

      <input
        id="expenseAmount"
        type="number"
        min="0"
        placeholder="টাকা">

    </div>

    <div>

      <label>
        বিবরণ
      </label>

      <input
        id="expenseNote"
        placeholder="কি কিনেছেন?">

    </div>

  </div>

  <button
    class="btn"
    style="margin-top:10px"
    onclick="addExpense()">
    খরচ Save
  </button>

</section>


<!-- MONTH -->

<section class="card">

  <div class="between">

    <h2>
      📅 মাসিক হিসাব
    </h2>

    <input
      id="monthPick"
      type="month"
      style="max-width:180px"
      onchange="render()">

  </div>

  <div class="grid">

    <div class="stat">
      <span>মাসের আয়</span>
      <b id="monthIncome">৳0</b>
    </div>

    <div class="stat">
      <span>মাসের খরচ</span>
      <b id="monthExpense">৳0</b>
    </div>

    <div class="stat">
      <span>মাসের লাভ</span>
      <b id="monthProfit">৳0</b>
    </div>

    <div class="stat">
      <span>চালু দিন</span>
      <b id="runDays">0</b>
    </div>

  </div>

</section>


<!-- VEHICLE PURCHASE -->

<section class="card">

  <div class="between">

    <h2>
      🚕 গাড়ির ক্রয় / বিনিয়োগ
    </h2>

    <button
      class="btn no-print"
      onclick="saveVehicle()">
      Save
    </button>

  </div>

  <div class="grid">

    <div>

      <label>
        গাড়ির নাম
      </label>

      <input
        id="carName"
        placeholder="CNG-01">

    </div>

    <div>

      <label>
        কেনার তারিখ
      </label>

      <input
        id="carDate"
        type="date">

    </div>

    <div>

      <label>
        কেনার দাম
      </label>

      <input
        id="carPrice"
        type="number"
        min="0">

    </div>

    <div>

      <label>
        দৈনিক রিকভারি
      </label>

      <input
        id="carRate"
        type="number"
        min="0"
        value="500">

    </div>

  </div>

  <div style="margin-top:12px">

    <div class="between">

      <span>
        Recovery
      </span>

      <b id="recoveryText">
        ৳0 / ৳0
      </b>

    </div>

    <div class="progress">

      <i id="recoveryBar"></i>

    </div>

  </div>

</section>


<!-- DAILY -->

<section class="card">

  <div class="between">

    <h2>
      🧾 দৈনিক তালিকা
    </h2>

    <button
      class="btn no-print"
      onclick="downloadPDF()">
      📄 PDF Save
    </button>

  </div>

  <div class="scroll">

    <table>

      <thead>

        <tr>

